{{!< default}}

{{#is "home"}}
<section class="masthead">
    <img class="masthead-logo" src="{{asset "images/logo.jpg"}}" alt="{{@site.title}}">
    <h1 class="masthead-tagline">Notes on going first</h1>
    <figure class="masthead-origin">
        <blockquote class="origin-quote">&ldquo;You are my first pancake. The first ones never come out quite right.&rdquo;</blockquote>
        <p class="origin-reply">&ldquo;Thanks, Mom.&rdquo;</p>
    </figure>
    <hr class="masthead-rule">
</section>
{{/is}}

<section class="post-list">
    {{#foreach posts}}
        <article class="post-list-item">
            <div class="post-list-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
                {{#if primary_tag}} &middot; {{primary_tag.name}}{{/if}}
                {{#if reading_time}} &middot; {{reading_time}}{{/if}}
            </div>
            <h2 class="post-list-title">
                <a href="{{url}}">{{title}}</a>
            </h2>
            {{#if custom_excerpt}}
                <p class="post-list-excerpt">{{custom_excerpt}}</p>
            {{else}}
                <p class="post-list-excerpt">{{excerpt words="38"}}</p>
            {{/if}}
        </article>
    {{/foreach}}

    {{pagination}}
</section>
