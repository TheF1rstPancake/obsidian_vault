# Obsidian internals
.obsidian/workspace*.json

# Processed audio (large binary files — don't version)
archive/
recordings/

# Scripts and meta (keep locally, not needed in backup)
*.log

# Pre-update draft snapshots from process-recordings.sh
drafts/**/*.bak.*

# Editorial pipeline artifacts — generated, disposable, and bundle annotation
# text we don't want auto-pushed to the public repo. Regenerate with `make article-context`.
drafts/**/.pipeline/

# Secrets — never commit
.env
.env.*
__pycache__/
*.pyc

# Local agent task scratch/state (do not publish)
.agent-task/
